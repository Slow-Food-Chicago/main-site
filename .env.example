# Feature Flags
# Set to 'true' to display Slack invite links and mentions across the site (hidden by default)
VITE_SHOW_SLACK=false

# Google Calendar API (optional)
# VITE_GOOGLE_CALENDAR_API_KEY=

# New Relic Browser Monitoring (Browser Token Method for React SPAs)
# Reference: https://docs.newrelic.com/docs/new-relic-solutions/best-practices-guides/full-stack-observability/browser-monitoring-best-practices-guide/
# --------------------------------------------------------------------------------------------------------------------
# 1. New Relic Browser Token / Key (starts with NRJS-...)
# Located in New Relic Browser Settings or API keys -> Browser Key
# VITE_NEW_RELIC_BROWSER_TOKEN=NRJS-your_browser_token_here

# 2. Application ID (numeric ID from New Relic Browser application settings)
# VITE_NEW_RELIC_APPLICATION_ID=your_application_id_here

# 3. Account ID (numeric New Relic account ID)
# VITE_NEW_RELIC_ACCOUNT_ID=your_account_id_here

# 4. Optional: Trust Key for distributed tracing (defaults to Account ID)
# VITE_NEW_RELIC_TRUST_KEY=

# 5. Optional: Region ('us' or 'eu', defaults to 'us')
# VITE_NEW_RELIC_REGION=us

# 6. Optional: Enable console debugging for New Relic in local dev (true/false)
# VITE_NEW_RELIC_DEBUG=false

# 7. Optional: Master switch to enable/disable New Relic monitoring (defaults to true)
# VITE_NEW_RELIC_ENABLED=true
